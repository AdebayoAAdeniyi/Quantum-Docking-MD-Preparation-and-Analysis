# atomic_number.awk - print the atomic number of the element in column 1
# (case insensitive: RU, ru and Ru all give 44)
BEGIN {
    Z["H"]=1
    Z["He"]=2
    Z["Li"]=3
    Z["Be"]=4
    Z["B"]=5
    Z["C"]=6
    Z["N"]=7
    Z["O"]=8
    Z["F"]=9
    Z["Ne"]=10
    Z["Na"]=11
    Z["Mg"]=12
    Z["Al"]=13
    Z["Si"]=14
    Z["P"]=15
    Z["S"]=16
    Z["Cl"]=17
    Z["Ar"]=18
    Z["K"]=19
    Z["Ca"]=20
    Z["Sc"]=21
    Z["Ti"]=22
    Z["V"]=23
    Z["Cr"]=24
    Z["Mn"]=25
    Z["Fe"]=26
    Z["Co"]=27
    Z["Ni"]=28
    Z["Cu"]=29
    Z["Zn"]=30
    Z["Ga"]=31
    Z["Ge"]=32
    Z["As"]=33
    Z["Se"]=34
    Z["Br"]=35
    Z["Kr"]=36
    Z["Rb"]=37
    Z["Sr"]=38
    Z["Y"]=39
    Z["Zr"]=40
    Z["Nb"]=41
    Z["Mo"]=42
    Z["Tc"]=43
    Z["Ru"]=44
    Z["Rh"]=45
    Z["Pd"]=46
    Z["Ag"]=47
    Z["Cd"]=48
    Z["In"]=49
    Z["Sn"]=50
    Z["Sb"]=51
    Z["Te"]=52
    Z["I"]=53
    Z["Xe"]=54
    Z["Cs"]=55
    Z["Ba"]=56
    Z["La"]=57
    Z["Ce"]=58
    Z["Pr"]=59
    Z["Nd"]=60
    Z["Pm"]=61
    Z["Sm"]=62
    Z["Eu"]=63
    Z["Gd"]=64
    Z["Tb"]=65
    Z["Dy"]=66
    Z["Ho"]=67
    Z["Er"]=68
    Z["Tm"]=69
    Z["Yb"]=70
    Z["Lu"]=71
    Z["Hf"]=72
    Z["Ta"]=73
    Z["W"]=74
    Z["Re"]=75
    Z["Os"]=76
    Z["Ir"]=77
    Z["Pt"]=78
    Z["Au"]=79
    Z["Hg"]=80
    Z["Tl"]=81
    Z["Pb"]=82
    Z["Bi"]=83
    Z["Po"]=84
    Z["At"]=85
    Z["Rn"]=86
}
{ s = toupper(substr($1,1,1)) tolower(substr($1,2)); gsub(/[^A-Za-z]/, "", s)
  if (!(s in Z)) { print "unknown element: " $1 > "/dev/stderr"; exit 1 }
  print Z[s] }
