title "ts-iso-ts ts"
echo
start ts-iso-ts
memory total 1536 mb
charge 0
permanent_dir ./perm
scratch_dir ./perm
geometry  units angstrom nocenter noautosym noautoz
  C                  0.05826000    -0.00000000     0.04302000
  N                 -0.08697000    -0.00000000     1.22574000
