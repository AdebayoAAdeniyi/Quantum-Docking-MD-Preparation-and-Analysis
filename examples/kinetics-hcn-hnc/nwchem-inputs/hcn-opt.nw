title "hcn-opt opt"
echo
start hcn-opt
memory total 1536 mb
charge 0
permanent_dir ./perm
scratch_dir ./perm
geometry  units angstrom nocenter noautosym noautoz
  C                  0.00000000     0.00000000     0.00000000
  N                  0.00000000     0.00000000     1.15600000
  H                  0.00000000     0.00000000    -1.06600000
end
basis spherical
  * library 6-31g*
end
dft
  xc b3lyp
  mult 1
  grid fine
  maxiter 500
  convergence energy 1d-8
end
driver
  maxiter 300
  tight
  xyz hcn-opt
end
task dft optimize
freq
  temp 4 250 298.15 350 400
end
task dft freq
