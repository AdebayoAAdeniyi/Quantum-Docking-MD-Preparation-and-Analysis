UNITS NATURAL
p: DISTANCE ATOMS=1,2 COMPONENTS NOPBC
pot: CUSTOM ARG=p.x,p.y VAR=x,y FUNC=5*(x^2-1)^2+2*y^2 PERIODIC=NO
BIASVALUE ARG=pot
mt: METAD ARG=p.x SIGMA=0.1 HEIGHT=0.2 PACE=200 BIASFACTOR=10 TEMP=1.0 GRID_MIN=-3 GRID_MAX=3 FILE=HILLS
UPPER_WALLS ARG=p.x AT=2.0 KAPPA=100
LOWER_WALLS ARG=p.x AT=-2.0 KAPPA=100
PRINT ARG=p.x,mt.bias STRIDE=200 FILE=COLVAR
