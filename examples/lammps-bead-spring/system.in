# bead-spring polymer, reduced LJ units
units           lj
atom_style      bond
boundary        p p p
read_data       ${data}
bond_style      harmonic
bond_coeff      1 500.0 0.97
special_bonds   lj 0.0 1.0 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_modify     shift yes
neighbor        0.4 bin
neigh_modify    every 1 delay 0 check yes
